# Keep "healthy" for normal operation.
# Demo-only values: healthy | runtime | persistent | dependency | ambiguous
# Do not use demo fault modes on a real production app.
DEMO_FAULT_MODE=healthy

# Demo control API (off by default). Both are required to enable mutations,
# and every mutation must present the token as: Authorization: Bearer <token>
# The Host header is never treated as authentication (it is spoofable).
# For local demos only: bind the dev server to loopback, e.g.
#   next dev -H 127.0.0.1 -p 3000
DEMO_CONTROLS_ENABLED=false
DEMO_CONTROL_TOKEN=

# Browser-side token so the page can call the demo control API in a local
# demo. Leave empty in any non-local deployment.
NEXT_PUBLIC_DEMO_CONTROL_TOKEN=
